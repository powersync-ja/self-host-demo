# ==================== Convex config =========================================
# Convex backend API (accessible from host)
CONVEX_PORT=3210
# Convex HTTP actions / JWKS endpoint (accessible from host)
CONVEX_SITE_PORT=3211
# Convex dashboard
CONVEX_DASHBOARD_PORT=6791

# ==================== Demo config ============================================
# The front-end demo application is accessible at this port on the host machine
DEMO_CLIENT_PORT=3030

# ==================== PowerSync variables ====================================
# The PowerSync API is accessible via this port on the host machine
PS_PORT=8080
